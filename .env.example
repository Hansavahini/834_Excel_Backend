# Copy to backend/.env and edit.
#
# This file is now actually read. It previously was not: settings.py took every
# value from os.environ directly and nothing loaded the file, so the committed
# development SECRET_KEY was in use no matter what was written here. A real
# environment variable still wins over anything set below, so a container's
# configuration is never overwritten by a checked-in file.

# ---------------------------------------------------------------------------
# IMPORTANT: SECRET_KEY is not only a session key here.
#
# members.models.ssn_fingerprint uses it as the HMAC pepper for member identity
# matching. Change it after members exist and every stored fingerprint stops
# matching, which silently duplicates members on the next upload. Set it once,
# before the first upload, and keep it for the life of the database. If you must
# rotate it, re-run `python manage.py resync_members` afterwards.
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-before-first-upload-and-never-again

DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to hold a session cookie. Drives CORS and CSRF together.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Largest 834 accepted, in bytes. Default is 200 MB.
MAX_834_UPLOAD_BYTES=209715200

EDI_LOG_LEVEL=INFO

# Default accounts created by `python manage.py bootstrap_users`.
PORTAL_ADMIN_USER=admin
PORTAL_ADMIN_PASSWORD=admin12345
PORTAL_ADMIN_EMAIL=admin@onesmarter.local
PORTAL_CLIENT_USER=client
PORTAL_CLIENT_PASSWORD=client12345
PORTAL_CLIENT_EMAIL=client@abchealth.com

# Postgres. Leave POSTGRES_DB unset to stay on SQLite.
# POSTGRES_DB=edi834
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# --- SSN pepper -------------------------------------------------------------
# Keys the HMAC that identifies members without their plaintext SSN. Defaults to
# SECRET_KEY so an existing database keeps matching; set it explicitly and the
# two can then rotate independently. Changing it after members exist stops every
# stored fingerprint matching, which duplicates people silently.
# SSN_PEPPER=

# --- Database ---------------------------------------------------------------
# SQLite is the supported database. The path is configurable so a container can
# mount the file on a volume.
# SQLITE_PATH=/var/lib/onesmarter/db.sqlite3
# SQLITE_TIMEOUT=30

# --- Storage ----------------------------------------------------------------
# Uploaded 834s and generated workbooks. Contains PHI; it is deliberately not
# served by the URL conf, so put it somewhere the web server cannot reach.
# DJANGO_MEDIA_ROOT=/var/lib/onesmarter/media

# --- Upload limits ----------------------------------------------------------
# MAX_834_UPLOAD_BYTES is enforced at the upload endpoint. Raise both together:
# Django refuses an oversized multipart body before the view ever sees it.
# FILE_UPLOAD_MAX_MEMORY_SIZE=2097152
# DATA_UPLOAD_MAX_MEMORY_SIZE=5242880

# --- Date format ------------------------------------------------------------
# The one format the portal writes and displays: workbook cells, API output and
# the browser. Change both together or the workbook and the screen disagree.
# DISPLAY_DATE_FORMAT=%m-%d-%Y
# EXCEL_DATE_FORMAT=MM-DD-YYYY

# --- Session ----------------------------------------------------------------
# SESSION_COOKIE_AGE=28800
